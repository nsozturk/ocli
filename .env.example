# ocli reads no credentials. This is the only environment variable it uses, and it is optional.
# The scripts do not load this file: export the variable in your shell.

# Where dispatch.mjs writes and digest.mjs reads the live run files. Default: <cwd>/orchestra/live.
# If you set it, point the plugin's `liveDirs` option at the same absolute path.
ORCHESTRA_LIVE_DIR=
